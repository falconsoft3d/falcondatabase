# falcondatabase configuration.
# For Docker installs, ./install.sh generates .env for you. For local development,
# copy this file to .env and adjust it.

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Required behind HTTPS, e.g. https://db.example.com
# CSRF_TRUSTED_ORIGINS=https://db.example.com
# true when an HTTPS reverse proxy (Caddy, nginx...) sets X-Forwarded-Proto
USE_HTTPS=false
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=falcondatabase
POSTGRES_USER=falcon
POSTGRES_PASSWORD=falcon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- falcondatabase -------------------------------------------------------
# Default interface language: es or en (each visitor can switch it).
FALCONDB_LANGUAGE=en
# Origins allowed to call the API from a browser ("*" = any), comma separated.
FALCONDB_CORS_ORIGINS=*
# Lifetime of the tokens of your apps' users, in seconds (7 days).
FALCONDB_TOKEN_MAX_AGE=604800
# Maximum rows returned by one API request.
FALCONDB_MAX_PAGE_SIZE=1000
# Contact shown in the footer and in the cookie policy.
FALCONDB_CONTACT_NAME="Marlon Falcon Hernández"
FALCONDB_CONTACT_EMAIL="mfalconsoft@gmail.com"

# --- Docker only (used by docker-compose.yml) -------------------------------
# FALCONDB_PORT=8000
# FALCONDB_BIND=0.0.0.0
# FALCONDB_DOMAIN=db.example.com
# WEB_CONCURRENCY=3
