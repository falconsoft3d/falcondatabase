# Copy to .env and adjust.
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://falcondatabase.example.com

POSTGRES_DB=falcondatabase
POSTGRES_USER=falcon
POSTGRES_PASSWORD=falcon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Origins allowed to call the API from the browser ("*" = any).
FALCONDB_CORS_ORIGINS=*
# Lifetime of end-user tokens in seconds (7 days).
FALCONDB_TOKEN_MAX_AGE=604800
FALCONDB_MAX_PAGE_SIZE=1000

# Contact shown in the site footer.
FALCONDB_CONTACT_NAME=Marlon Falcon Hernández
FALCONDB_CONTACT_EMAIL=mfalconsoft@gmail.com
